# Optional server-side fallbacks (users usually paste keys in Workspace).
# For 即梦 / 方舟: paste Ark API Key as AI_GATEWAY_API_KEY and set image/video
# models to doubao-seedream-* / doubao-seedance-* in the UI.
AI_GATEWAY_API_KEY=
FAL_KEY=
# Optional alias also accepted by the app
# FAL_FAL_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL（本地 / 云端只改这一行）
# 云端 Docker：api 使用 network_mode=host，保持 @127.0.0.1:3306（宝塔 MySQL 常见）
# 例：mysql+pymysql://用户名:密码@127.0.0.1:3306/lensmith
DATABASE_URL=

# JWT 签名密钥（随便一长串随机字符，本地和云端可以不同）
JWT_SECRET=

# Token 有效期（分钟），默认 7 天
# JWT_EXPIRE_MINUTES=10080
