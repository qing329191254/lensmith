{
  "name": "lensmith",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "conda run -n lensmith --no-capture-output python server/run.py",
    "dev:client": "pnpm --filter lensmith-client dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
